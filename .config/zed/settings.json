// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tab_size": 2,
  "server_url": "https://zed.dev",
  "proxy": "",
  "markdown_preview_code_font_family": "Hack Nerd Font",
  "markdown_preview_font_family": "Hiragino Sans",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Hack Nerd Font",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "ui_font_weight": 400.0,
  "ui_font_family": ".ZedMono",
  "project_panel": {
    "hide_gitignore": false,
    "default_width": 350.0,
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "light",
    "light": "Tokyo Night Storm",
    "dark": "Tokyo Night",
  },
  "file_finder": {
    "modal_max_width": "medium"
  }
}
